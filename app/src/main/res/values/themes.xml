<resources>
    <style name="Theme.Savr" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <!-- Launch theme: system splash (Android 12+ style on all versions), then Theme.Savr -->
    <style name="Theme.Savr.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/olive</item>
        <item name="postSplashScreenTheme">@style/Theme.Savr</item>
    </style>
</resources>
